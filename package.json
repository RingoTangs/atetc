{
  "name": "atetc",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "description": "A TypeScript npm library template powered by tsdown.",
  "author": "RingoTangs",
  "license": "MIT",
  "homepage": "https://github.com/RingoTangs/tsdown-template#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RingoTangs/tsdown-template.git"
  },
  "bugs": {
    "url": "https://github.com/RingoTangs/tsdown-template/issues"
  },
  "keywords": [
    "typescript",
    "tsdown",
    "npm-package",
    "library",
    "template"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=22"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "tsdown",
    "build": "cross-env NODE_ENV=production tsdown",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -b",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test:run",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "pnpm check && pnpm build && pnpm pack:check"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.3.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^22.20.4",
    "cross-env": "^10.1.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.9.8",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
