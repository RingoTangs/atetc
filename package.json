{
  "name": "atetc",
  "type": "module",
  "version": "0.1.1-alpha.4",
  "packageManager": "pnpm@10.24.0",
  "description": "CLI and TypeScript library for inspecting, unpacking, and rebuilding etc.pak archives.",
  "author": "RingoTangs",
  "license": "MIT",
  "homepage": "https://github.com/RingoTangs/atetc#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RingoTangs/atetc.git"
  },
  "bugs": {
    "url": "https://github.com/RingoTangs/atetc/issues"
  },
  "keywords": [
    "typescript",
    "cli",
    "pak",
    "lzss",
    "archive"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "default": "./dist/index.mjs"
    }
  },
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "bin": {
    "atetc": "dist/cli.mjs"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.2",
      "onFail": "error"
    }
  },
  "scripts": {
    "dev": "tsdown",
    "build": "cross-env NODE_ENV=production tsdown",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --check .",
    "format:fix": "prettier --write .",
    "typecheck": "tsc -b",
    "check": "pnpm lint && pnpm format && pnpm typecheck && pnpm test:run",
    "check:fix": "pnpm lint:fix && pnpm format:fix",
    "pack:check": "npm pack --dry-run",
    "prepublishOnly": "pnpm check && pnpm build && pnpm pack:check"
  },
  "dependencies": {
    "chalk": "^6.0.0",
    "commander": "^15.0.0",
    "iconv-lite": "^0.7.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "8.3.0",
    "@prettier/plugin-xml": "^3.4.2",
    "@types/node": "^22.20.4",
    "cross-env": "^10.1.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "prettier": "^3.9.8",
    "tsdown": "^0.23.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
